<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pg_slam_py</name>
  <version>0.1.0</version>
  <description>04 课：slam_toolbox 在线建图（键盘遥控 / 自动漫游）</description>
  <maintainer email="mymuse@foxmail.com">Richie</maintainer>
  <license>Apache-2.0</license>

  <!-- launch 文件：仿真 + SLAM + 两种探索方式 -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>pg_sim</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <!-- explore:=auto 时复用 02 课的避障漫游节点 -->
  <exec_depend>pg_obstacle_avoidance_py</exec_depend>
  <!-- explore:=teleop 时在另一个终端运行键盘遥控 -->
  <exec_depend>turtlebot3_teleop</exec_depend>

  <!-- 测试依赖：代码风格检查、文档字符串检查、单元测试框架 -->
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
