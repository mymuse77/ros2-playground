Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  # Nav2 面板：显示导航状态、剩余距离、恢复次数，可以暂停 / 重启 Nav2 的生命周期节点
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    # 04 课建好的地图：map_server 用 Transient Local 发布
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 1
      Color Scheme: map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Value: true
    # 全局代价地图：障碍周围的彩色是膨胀层，颜色越"热"代价越高
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Alpha: 0.4
      Color Scheme: costmap
      Draw Behind: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Value: true
    # 局部代价地图：跟着车走的 3 m × 3 m 窗口，只有雷达看到的障碍
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Alpha: 0.6
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Value: true
    # 规划器输出的全局路径
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Enabled: true
      Color: 25; 255; 0
      Line Style: Billboards
      Line Width: 0.03
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
      Value: true
    # DWB 选中的那条局部轨迹（往前模拟 1.5 s）；RPP、MPPI 不发布这个话题
    - Class: rviz_default_plugins/Path
      Name: Local Plan (DWB)
      Enabled: true
      Color: 255; 170; 0
      Line Style: Lines
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_plan
      Value: true
    # RPP 的"胡萝卜点"：在路径上前视距离处，车朝它开
    - Class: rviz_default_plugins/PointStamped
      Name: Lookahead Point (RPP)
      Enabled: true
      Color: 255; 0; 255
      Radius: 0.08
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lookahead_point
      Value: true
    # AMCL 的粒子：每个箭头是一个"猜测的位姿"，收敛后聚成一小团
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: AMCL Particles
      Enabled: true
      Color: 0; 180; 255
      Shape: Arrow (Flat)
      Arrow Length: 0.1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /particle_cloud
      Value: true
    # 代价地图使用的车身轮廓（robot_radius 画出来的圆）
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Color: 0; 255; 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/published_footprint
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Color Transformer: FlatColor
      Color: 255; 60; 60
      Size (m): 0.04
      Style: Flat Squares
      Decay Time: 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Frames:
        All Enabled: false
        map:
          Value: true
        odom:
          Value: true
        base_footprint:
          Value: true
      Show Names: true
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    # "2D Pose Estimate"：告诉 AMCL 小车在哪（发布 /initialpose）
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    # "2D Goal Pose"：发一个导航目标（bt_navigator 订阅 /goal_pose）
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 100
      X: 1.8
      Y: 0.5
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
