<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pg_nav2_py</name>
  <version>0.1.0</version>
  <description>05 课：Nav2 导航与多点巡逻</description>
  <maintainer email="mymuse@foxmail.com">Richie</maintainer>
  <license>Apache-2.0</license>

  <!-- launch 文件：仿真 + Nav2 + RViz，地图来自 pg_sim -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>pg_sim</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <!-- 参数文件里加载的规划器、控制器插件 -->
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>nav2_theta_star_planner</exec_depend>
  <exec_depend>nav2_dwb_controller</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <!-- RViz 里的 Nav2 面板和粒子显示 -->
  <exec_depend>nav2_rviz_plugins</exec_depend>
  <!-- 巡逻节点：BasicNavigator、航点文件（YAML）、RViz 航点标记 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- 仿真验收：02 课的安全监视节点 safety_monitor -->
  <exec_depend>pg_obstacle_avoidance_py</exec_depend>

  <!-- 测试依赖：代码风格检查、文档字符串检查、单元测试框架 -->
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
