Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Color Transformer: FlatColor
      Color: 255; 60; 60
      Size (m): 0.04
      Style: Flat Squares
      Decay Time: 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Bug2
      Enabled: true
      Namespaces:
        m_line: true
        goal: true
        hit_point: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /navigate_server/markers
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Keep: 1000
      Position Tolerance: 0.05
      Angle Tolerance: 0.5
      Shape:
        Value: Arrow
        Color: 80; 160; 255
        Alpha: 1
        Shaft Length: 0.15
        Shaft Radius: 0.01
        Head Length: 0.05
        Head Radius: 0.03
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odom
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    # "2D Goal Pose"：在地图上点击并拖动，向 /goal_pose 发布目标（mode:=p 时使用）
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 70
      X: 0.5
      Y: 0
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Height: 860
  Width: 1280
